      },
      {
        "path": "src/components/doc-page-surfaces.tsx",
        "category": "nonvisual-composition",
        "reason": "Barrel re-exporting the page surfaces so stories, fixtures and tests keep one import path; each surface is registered separately."
      },
      {
        "path": "src/editor/extensions.tsx",
        "category": "application-adapter",
        "reason": "Tiptap extension set and node views assembled into the live editor by use-doc-rich-editor; the article surface stories render the editor result, and the behaviour is proven by the editor component tests."
      },
      {
        "path": "src/editor/media.tsx",
        "category": "application-adapter",
        "reason": "Tiptap media node views and upload plugin mounted only inside a live editor instance; behaviour is proven by media.component.test.tsx, and no registered story renders a live editor node view."
      },
      {
        "path": "src/editor/code-block.tsx",
        "category": "application-adapter",
        "reason": "Tiptap code block node view mounted only inside a live editor instance; behaviour is proven by code-fence.component.test.tsx, and no registered story renders a live editor node view."
      },
      {
        "path": "src/editor/caption-editor.tsx",
        "category": "application-adapter",
        "reason": "Nested Tiptap editor for media captions, created by the media node view inside a live editor instance; behaviour is proven by media.component.test.tsx."
      }
