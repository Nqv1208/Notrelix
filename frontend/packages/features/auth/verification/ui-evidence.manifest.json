      },
      {
        "path": "src/web/components/microsoft-mark.tsx",
        "category": "nonvisual-composition",
        "reason": "Vendor brand mark (Microsoft four squares, fixed brand colours) rendered inside the sign-in surface; covered by its stories and exempt from the token gate through VENDOR_MARK_FILES."
      },
      {
        "path": "src/web/components/register-form.tsx",
        "category": "container",
        "reason": "Container composing AuthRegisterFormSurface with account-scoped session actions."
      },
      {
        "path": "src/web/containers/forgot-flow.tsx",
        "category": "container",
        "reason": "Container holding the reset request and the resend countdown and composing AuthForgotSurface."
      },
      {
        "path": "src/web/containers/invite-flow.tsx",
        "category": "container",
        "reason": "Container reading the guest invitation and composing AuthInviteSurface with its accept and decline writes."
      },
      {
        "path": "src/web/containers/sign-in-flow.tsx",
        "category": "container",
        "reason": "Container holding the sign-in state machine (identify, login, second step, single sign-on) and composing AuthSignInSurface."
      },
      {
        "path": "src/web/containers/verify-email-flow.tsx",
        "category": "container",
        "reason": "Container confirming the emailed token and sending a new link, composing AuthVerifyEmailSurface."
      }
    ]
