{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**", "expo/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": ["coverage/**"]
    },
    "format": {
      "outputs": []
    },
    "codegen": {
      "inputs": [
        "../../../backend/contracts/openapi/notrelix.v1.json",
        "../../../artifacts/contracts/realtime.v1.json",
        "openapi/**",
        "asyncapi/**"
      ],
      "outputs": ["../../packages/foundation/contracts/src/generated/**"]
    },
    "check:deps": {
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
