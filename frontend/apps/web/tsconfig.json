{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@notrelix/kernel": ["../../packages/foundation/kernel/src/index.ts"],
      "@notrelix/kernel/*": ["../../packages/foundation/kernel/src/*"],
      "@notrelix/platform": ["../../packages/foundation/platform/src/index.ts"],
      "@notrelix/platform/*": ["../../packages/foundation/platform/src/*"],
      "@notrelix/contracts": ["../../packages/foundation/contracts/src/index.ts"],
      "@notrelix/contracts/*": ["../../packages/foundation/contracts/src/*"],
      "@notrelix/query": ["../../packages/foundation/query/src/index.ts"],
      "@notrelix/query/*": ["../../packages/foundation/query/src/*"],
      "@notrelix/realtime": ["../../packages/foundation/realtime/src/index.ts"],
      "@notrelix/realtime/*": ["../../packages/foundation/realtime/src/*"],
      "@notrelix/observability": ["../../packages/foundation/observability/src/index.ts"],
      "@notrelix/ui-tokens": ["../../packages/ui/tokens/src/index.ts"],
      "@notrelix/ui-tokens/*": ["../../packages/ui/tokens/src/*"],
      "@notrelix/ui-web": ["../../packages/ui/web/src/index.ts"],
      "@notrelix/ui-web/*": ["../../packages/ui/web/src/*"],
      "@notrelix/runtime-web": ["../../packages/runtimes/web/src/index.ts"],
      "@notrelix/wm-core": ["../../packages/product/work-management/core/src/index.ts"],
      "@notrelix/wm-core/*": ["../../packages/product/work-management/core/src/*"],
      "@notrelix/wm-state": ["../../packages/product/work-management/state/src/index.ts"],
      "@notrelix/wm-state/*": ["../../packages/product/work-management/state/src/*"],
      "@notrelix/wm-web": ["../../packages/product/work-management/web/src/index.ts"],
      "@notrelix/docs-core": ["../../packages/product/docs/core/src/index.ts"],
      "@notrelix/docs-web": ["../../packages/product/docs/web/src/index.ts"],
      "@notrelix/automation-web": ["../../packages/product/automation/web/src/index.ts"],
      "@notrelix/feature-auth": ["../../packages/features/auth/src/index.ts"],
      "@notrelix/feature-workspace": ["../../packages/features/workspace/src/index.ts"],
      "@notrelix/feature-account": ["../../packages/features/account/src/index.ts"]
    }
  },
  "include": ["src"]
}
