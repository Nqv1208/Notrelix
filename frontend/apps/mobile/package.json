    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "@notrelix/runtime-mobile": "workspace:*",
    "@notrelix/ui-mobile": "workspace:*",
    "@notrelix/ui-tokens": "workspace:*",
    "@notrelix/query": "workspace:*",
