# Diagnostic Dockerfile for web container A/B (alpine vs bookworm-slim)
# Temporary — delete after root cause decision.

ARG BASE_IMAGE=node:22-alpine

FROM $BASE_IMAGE AS base
RUN corepack enable
WORKDIR /app

FROM base AS builder

COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml frontend/.npmrc ./
COPY frontend/turbo.json ./
COPY frontend/tooling ./tooling
COPY frontend/packages ./packages
COPY frontend/apps/web ./apps/web
COPY frontend/scripts/docker-watch-build.sh ./scripts/docker-watch-build.sh

RUN pnpm install --frozen-lockfile
RUN sh ./scripts/docker-watch-build.sh "pnpm --filter @notrelix/app-web build"

# Stage 3: Production image
FROM nginx:alpine AS production

COPY frontend/apps/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
