{
  "scripts": {
    "check:architecture": "pnpm --filter @notrelix/dependency-rules check",
    "check:ui-purity": "tsx tooling/dependency-rules/src/check-ui-purity.ts",
    "check:ui-actions": "tsx tooling/dependency-rules/src/check-ui-actions.ts",
    "check:ui-evidence": "pnpm storybook:web:build && tsx tooling/storybook/web/src/evidence/check-ui-evidence.ts",
    "storybook:web:build": "pnpm --filter @notrelix/storybook-web build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test:web:guarded": "vitest run --config tooling/testing/vitest.web.config.ts",
    "test:ui:freeze": "playwright test --config playwright.storybook.config.ts",
    "validate:ui": "pnpm run-ui && pnpm check:architecture && pnpm test:ui:freeze",
    "run-ui": "pnpm pre-screen && pnpm check:ui-purity",
    "pre-screen": "pnpm codegen:check"
  }
}