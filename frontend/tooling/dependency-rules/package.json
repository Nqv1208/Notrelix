{
  "name": "@notrelix/dependency-rules",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "check": "tsx src/run-checks.ts",
    "check:deps": "tsx src/run-checks.ts",
    "docs:generate": "tsx src/generate-architecture-docs.ts",
    "docs:check": "tsx src/generate-architecture-docs.ts --check",
    "test": "vitest run",
    "clean": "rm -rf node_modules",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@notrelix/eslint-config": "workspace:*",
    "@notrelix/i18n": "workspace:*",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0"
  }
}
