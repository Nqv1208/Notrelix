# Notrelix marketing container with a pruned dependency closure and
# digest-pinned build/runtime base.
ARG NODE_BASE_IMAGE=node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32

FROM ${NODE_BASE_IMAGE} AS base
RUN corepack enable && corepack prepare pnpm@10.0.0 --activate
WORKDIR /repo

FROM base AS pruner
COPY frontend ./frontend
WORKDIR /repo/frontend
RUN pnpm dlx turbo@2.10.5 prune @notrelix/app-marketing --docker

FROM base AS builder
WORKDIR /app
COPY --from=pruner /repo/frontend/out/json/ ./
COPY --from=pruner /repo/frontend/out/pnpm-lock.yaml ./pnpm-lock.yaml
COPY frontend/.npmrc ./.npmrc
RUN pnpm install --frozen-lockfile
COPY --from=pruner /repo/frontend/out/full/ ./
RUN pnpm --filter @notrelix/app-marketing build

FROM ${NODE_BASE_IMAGE} AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000
RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 --ingroup nodejs nextjs
COPY --from=builder --chown=nextjs:nodejs /app/apps/marketing/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/marketing/.next/static ./apps/marketing/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/marketing/public ./apps/marketing/public
USER nextjs
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/ || exit 1
CMD ["node", "apps/marketing/server.js"]
