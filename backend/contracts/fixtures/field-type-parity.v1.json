{
  "$comment": "UC-WM-C17: one fixed dataset that the web client (core/field-types, filters) and the server's paged read (PostgresBoardItemPageReader) must sort and filter to the same result. Values are stored as the server stores them (a date is an ISO instant); option and person values are keys; each host maps them to its own ids. Items are listed in board order (one group): equal sort keys keep this order on both hosts. A case's `expected` lists item keys in result order.",
  "fields": [
    { "key": "text", "type": "text", "name": "Ghi chú ngắn" },
    { "key": "long", "type": "long_text", "name": "Mô tả" },
    { "key": "link", "type": "link", "name": "Liên kết" },
    { "key": "num", "type": "number", "name": "Điểm" },
    { "key": "date", "type": "date", "name": "Ngày giao" },
    { "key": "check", "type": "checkbox", "name": "Đã duyệt" },
    { "key": "prio", "type": "select", "name": "Mức ưu tiên", "options": ["cao", "trung", "thap"] },
    { "key": "status", "type": "status", "name": "Trạng thái", "options": ["can", "dang", "xong"] },
    { "key": "tags", "type": "multi_select", "name": "Thẻ", "options": ["a", "b", "c"] },
    { "key": "people", "type": "person", "name": "Người duyệt" },
    { "key": "calc", "type": "formula", "name": "Công thức" },
    { "key": "votes", "type": "vote", "name": "Bình chọn" }
  ],
  "people": ["u1", "u2", "u3"],
  "items": [
    { "key": "alpha", "values": { "text": "bảo trì", "long": "Dài một dòng", "link": "https://a.vn/x", "num": 10, "date": "2026-10-05T09:00:00Z", "check": true, "prio": "cao", "status": "dang", "tags": ["a", "b"], "people": ["u1"] } },
    { "key": "beta", "values": { "text": "An toàn", "link": "https://b.vn", "num": 2, "check": false, "prio": "thap", "status": "can", "tags": [], "people": ["u2", "u3"] } },
    { "key": "gamma", "values": { "text": "Đo lường", "long": "ngắn", "num": -3.5, "date": "2026-10-01T09:00:00Z", "status": "xong", "tags": ["c"] } },
    { "key": "delta", "values": { "text": "bao bì", "num": 10, "date": "2026-10-05T09:00:00Z", "check": true, "prio": "trung", "status": "dang", "tags": ["b", "c"], "people": ["u1", "u2"] } },
    { "key": "epsilon", "values": { "date": "2026-11-20T09:00:00Z", "check": false, "prio": "cao" } },
    { "key": "zeta", "values": { "text": "item 10", "long": "DÀI", "num": 100, "date": "2026-10-31T09:00:00Z", "prio": "thap", "status": "can", "tags": ["a"], "people": ["u3"] } },
    { "key": "eta", "values": { "text": "item 9", "num": 0, "date": "2026-09-30T09:00:00Z", "check": true, "status": "xong", "people": ["u2"] } },
    { "key": "theta", "values": { "text": "Ánh", "link": "https://c.vn", "num": 2, "prio": "trung", "tags": ["a", "c"] } }
  ],
  "sorts": [
    { "name": "text ascending", "sort": [["text", "asc"]], "expected": ["beta", "theta", "delta", "alpha", "gamma", "eta", "zeta", "epsilon"] },
    { "name": "text descending", "sort": [["text", "desc"]], "expected": ["epsilon", "zeta", "eta", "gamma", "alpha", "delta", "theta", "beta"] },
    { "name": "long text ascending", "sort": [["long", "asc"]], "expected": ["zeta", "alpha", "gamma", "beta", "delta", "epsilon", "eta", "theta"] },
    { "name": "link ascending", "sort": [["link", "asc"]], "expected": ["alpha", "beta", "theta", "gamma", "delta", "epsilon", "zeta", "eta"] },
    { "name": "number ascending", "sort": [["num", "asc"]], "expected": ["gamma", "eta", "beta", "theta", "alpha", "delta", "zeta", "epsilon"] },
    { "name": "number descending", "sort": [["num", "desc"]], "expected": ["epsilon", "zeta", "alpha", "delta", "beta", "theta", "eta", "gamma"] },
    { "name": "date ascending", "sort": [["date", "asc"]], "expected": ["eta", "gamma", "alpha", "delta", "zeta", "epsilon", "beta", "theta"] },
    { "name": "date descending", "sort": [["date", "desc"]], "expected": ["beta", "theta", "epsilon", "zeta", "alpha", "delta", "gamma", "eta"] },
    { "name": "checkbox ascending", "sort": [["check", "asc"]], "expected": ["beta", "epsilon", "alpha", "delta", "eta", "gamma", "zeta", "theta"] },
    { "name": "select by option order", "sort": [["prio", "asc"]], "expected": ["alpha", "epsilon", "delta", "theta", "beta", "zeta", "gamma", "eta"] },
    { "name": "status by option order, descending", "sort": [["status", "desc"]], "expected": ["epsilon", "theta", "gamma", "eta", "alpha", "delta", "beta", "zeta"] },
    { "name": "select then number descending", "sort": [["prio", "asc"], ["num", "desc"]], "expected": ["epsilon", "alpha", "delta", "theta", "zeta", "beta", "eta", "gamma"] }
  ],
  "filters": [
    { "name": "text contains, ignoring case and accents", "join": "and", "conditions": [["text", "contains", "BAO"]], "expected": ["alpha", "delta"] },
    { "name": "text contains đ as d", "join": "and", "conditions": [["text", "contains", "do"]], "expected": ["gamma"] },
    { "name": "text equals", "join": "and", "conditions": [["text", "equals", "BAO BÌ"]], "expected": ["delta"] },
    { "name": "text does not contain (empty passes)", "join": "and", "conditions": [["text", "not_contains", "item"]], "expected": ["alpha", "beta", "gamma", "delta", "epsilon", "theta"] },
    { "name": "text is empty", "join": "and", "conditions": [["text", "is_empty"]], "expected": ["epsilon"] },
    { "name": "long text contains", "join": "and", "conditions": [["long", "contains", "dai"]], "expected": ["alpha", "zeta"] },
    { "name": "link contains", "join": "and", "conditions": [["link", "contains", "a.vn"]], "expected": ["alpha"] },
    { "name": "link is not empty", "join": "and", "conditions": [["link", "is_not_empty"]], "expected": ["alpha", "beta", "theta"] },
    { "name": "number greater than", "join": "and", "conditions": [["num", "gt", "2"]], "expected": ["alpha", "delta", "zeta"] },
    { "name": "number at most", "join": "and", "conditions": [["num", "lte", "0"]], "expected": ["gamma", "eta"] },
    { "name": "number equals", "join": "and", "conditions": [["num", "equals", "10"]], "expected": ["alpha", "delta"] },
    { "name": "number is empty", "join": "and", "conditions": [["num", "is_empty"]], "expected": ["epsilon"] },
    { "name": "date before", "join": "and", "conditions": [["date", "before", "2026-10-05"]], "expected": ["gamma", "eta"] },
    { "name": "date between", "join": "and", "conditions": [["date", "between", "2026-10-01", "2026-10-31"]], "expected": ["alpha", "gamma", "delta", "zeta"] },
    { "name": "date equals", "join": "and", "conditions": [["date", "equals", "2026-10-05"]], "expected": ["alpha", "delta"] },
    { "name": "date is empty", "join": "and", "conditions": [["date", "is_empty"]], "expected": ["beta", "theta"] },
    { "name": "checkbox is true", "join": "and", "conditions": [["check", "is_true"]], "expected": ["alpha", "delta", "eta"] },
    { "name": "checkbox is false (unset counts)", "join": "and", "conditions": [["check", "is_false"]], "expected": ["beta", "gamma", "epsilon", "zeta", "theta"] },
    { "name": "select equals", "join": "and", "conditions": [["prio", "equals", "cao"]], "expected": ["alpha", "epsilon"] },
    { "name": "select not equals (empty passes)", "join": "and", "conditions": [["prio", "not_equals", "cao"]], "expected": ["beta", "gamma", "delta", "zeta", "eta", "theta"] },
    { "name": "select any of, or none", "join": "and", "conditions": [["prio", "has_any", "trung", "__none__"]], "expected": ["gamma", "delta", "eta", "theta"] },
    { "name": "status any of", "join": "and", "conditions": [["status", "has_any", "dang", "xong"]], "expected": ["alpha", "gamma", "delta", "eta"] },
    { "name": "status is empty", "join": "and", "conditions": [["status", "is_empty"]], "expected": ["epsilon", "theta"] },
    { "name": "multi-select any of", "join": "and", "conditions": [["tags", "has_any", "b"]], "expected": ["alpha", "delta"] },
    { "name": "multi-select all of", "join": "and", "conditions": [["tags", "has_all", "a", "c"]], "expected": ["theta"] },
    { "name": "multi-select is empty", "join": "and", "conditions": [["tags", "is_empty"]], "expected": ["beta", "epsilon", "eta"] },
    { "name": "person any of", "join": "and", "conditions": [["people", "has_any", "u2"]], "expected": ["beta", "delta", "eta"] },
    { "name": "person all of", "join": "and", "conditions": [["people", "has_all", "u1", "u2"]], "expected": ["delta"] },
    { "name": "person any of, or unassigned", "join": "and", "conditions": [["people", "has_any", "u3", "__none__"]], "expected": ["beta", "gamma", "epsilon", "zeta", "theta"] },
    { "name": "two conditions joined by AND", "join": "and", "conditions": [["check", "is_true"], ["num", "gte", "10"]], "expected": ["alpha", "delta"] },
    { "name": "two conditions joined by OR", "join": "or", "conditions": [["num", "gt", "50"], ["prio", "equals", "trung"]], "expected": ["delta", "zeta", "theta"] }
  ],
  "serverRefuses": [
    { "name": "a multi-select cannot be sorted on a paged board", "sort": [["tags", "asc"]] },
    { "name": "a person field cannot be sorted on a paged board", "sort": [["people", "asc"]] },
    { "name": "a formula cannot be sorted on a paged board", "sort": [["calc", "asc"]] },
    { "name": "a vote cannot be sorted on a paged board", "sort": [["votes", "asc"]] },
    { "name": "a formula cannot be filtered on a paged board", "join": "and", "conditions": [["calc", "is_empty"]] },
    { "name": "a vote cannot be filtered on a paged board", "join": "and", "conditions": [["votes", "is_empty"]] }
  ]
}
