{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Notrelix": "Information"
    }
  },

  "Database": {
    "MigrateOnStartup": false
  },

  "SeedData": {
    "Enabled": false,
    "RunOnStartup": false,
    "Profile": "Small",
    "ResetBeforeSeed": false
  },

  "HttpsRedirection": {
    "Enabled": true
  },

  "Messaging": {
    "Transport": "RabbitMQ",
    "RabbitMQ": {
      "Host": "",
      "Port": 5672,
      "VHost": "/",
      "Username": "",
      "Password": ""
    }
  }
}
