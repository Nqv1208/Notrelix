{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "MigrateOnStartup": false
  },

  "Rls": {
    "Enabled": false,
    "ApplyPoliciesOnStartup": false,
    "SetSessionContext": false
  },

  "DataProtection": {
    "ApplicationName": "Notrelix",
    "PersistKeys": false,
    "KeysPath": "/root/.aspnet/DataProtection-Keys"
  },

  "SeedData": {
    "Enabled": false,
    "RunOnStartup": false,
    "Profile": "Small",
    "ResetBeforeSeed": false
  },

  "JwtSettings": {
    "Audience": "",
    "Issuer": "",
    "SecretKey": "",
    "ExpireMinutes": 60,
    "RefreshTokenExpireDays": 7
  },

  "ForwardedHeaders": {
    "TrustAllInDevelopment": true,
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "HealthChecks": {
    "Outbox": {
      "DegradedPendingAgeMinutes": 5,
      "UnhealthyPendingAgeMinutes": 15,
      "UnhealthyDeadLetterCount": 1
    }
  },

  "RateLimiting": {
    "Policies": {
      "AuthStrictByIp": {
        "PermitLimit": 5,
        "WindowSeconds": 60,
        "Algorithm": "SlidingWindow",
        "FailMode": "Closed",
        "PartitionBy": "Ip"
      },
      "AuthByEmail": {
        "PermitLimit": 5,
        "WindowSeconds": 900,
        "Algorithm": "SlidingWindow",
        "FailMode": "Closed",
        "PartitionBy": "UserId"
      },
      "GeneralAuthenticated": {
        "PermitLimit": 300,
        "WindowSeconds": 60,
        "Algorithm": "TokenBucket",
        "FailMode": "Open",
        "PartitionBy": "UserId"
      },
      "GeneralAnonymous": {
        "PermitLimit": 60,
        "WindowSeconds": 60,
        "Algorithm": "SlidingWindow",
        "FailMode": "Open",
        "PartitionBy": "Ip"
      }
    }
  },

  "HttpsRedirection": {
    "Enabled": false
  },

  "N8n": {
    "Enabled": false,
    "InternalBaseUrl": "",
    "WebhookBasePath": "/webhook",
    "WebhookSecret": "",
    "SignatureToleranceSeconds": 300
  },

  "Email": {
    "Enabled": false,
    "ApiKey": "",
    "FromEmail": "onboarding@resend.dev",
    "FromName": "Notrelix"
  },

  "Smtp": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "FromEmail": "",
    "FromName": "Notrelix",
    "Username": "",
    "Password": "",
    "EnableSsl": true
  }
}
