{
  "Frontend": {
    "AppBaseUrl": "http://localhost:3080"
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379,abortConnect=false"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "ForwardedHeaders": {
    "RequireKnownProxyInProduction": false
  },
  "JwtSettings": {
    "SecretKey": "ci-test-secret-key-must-be-at-least-32-characters",
    "Issuer": "Notrelix.Tests",
    "Audience": "Notrelix.Tests",
    "ExpireMinutes": 60,
    "RefreshTokenExpireDays": 7
  }
}