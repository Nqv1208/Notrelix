{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "Notrelix": "Debug"
    }
  },

  "DataProtection": {
    "PersistKeys": true,
    "KeysPath": "App_Data/DataProtection-Keys"
  },

  "Database": {
    "MigrateOnStartup": true
  },

  "SeedData": {
    "Enabled": true,
    "RunOnStartup": true,
    "Profile": "Large",
    "ResetBeforeSeed": false
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001",
      "http://localhost:5173",
      "http://localhost:3080"
    ]
  },

  "HttpsRedirection": {
    "Enabled": false
  },

  "N8n": {
    "Enabled": true,
    "InternalBaseUrl": "http://localhost:5678",
    "WebhookBasePath": "/webhook",
    "WebhookSecret": "dev-notrelix-n8n-webhook-secret",
    "SignatureToleranceSeconds": 300
  },

  "Smtp": {
    "Enabled": false
  }
}
