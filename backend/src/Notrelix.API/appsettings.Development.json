{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "SeedData": {
    "Enabled": true,
    "Profile": "Large",
    "ResetBeforeSeed": false
  },
  "N8n": {
    "InternalBaseUrl": "http://localhost:5678",
    "WebhookBasePath": "/webhook",
    "WebhookSecret": "dev-notrelix-n8n-webhook-secret",
    "SignatureToleranceSeconds": 300
  },
  "Smtp": {
    "Enabled": false
  },
  "ConnectionStrings": {
    "NotrelixDb": "Host=localhost;Port=5432;Database=notrelix_dev;Username=postgres;Password=postgres;Include Error Detail=true",
    "Redis": "localhost:6379,Password=redis,abortConnect=false"
  }
}
