<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Notrelix.Architecture.Tests</RootNamespace>
  </PropertyGroup>

  <!-- TESTING -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="8.8.0" />
  </ItemGroup>

  <!-- PROJECT REFERENCES -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Notrelix.Domain\Notrelix.Domain.csproj" />
    <ProjectReference Include="..\..\src\Notrelix.Application\Notrelix.Application.csproj" />
    <ProjectReference Include="..\..\src\Notrelix.Infrastructure\Notrelix.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Notrelix.API\Notrelix.API.csproj" />
  </ItemGroup>

</Project>
