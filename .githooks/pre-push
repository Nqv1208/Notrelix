#!/usr/bin/env bash
# Local mirror of the cheap CI "Fast checks", run by git before a push leaves the machine.
# It looks only at the commits being pushed (the remote ref git passes on stdin) and runs only
# the checks of the side that changed:
#   backend/  -> dotnet format over the whole solution (unused usings, whitespace) and the Architecture tests
#   frontend/ -> prettier on the changed files, typecheck of the affected packages, check:architecture
# Everything heavy (build of the whole solution, Domain/Application/API/integration tests, web and node
# tests, lint, mock e2e) stays in CI: the old scripts/pre-push.sh ran those and was too slow to keep.
# The checks of one push run side by side; a failure names the check and the command that fixes it.
# Installed by `git config core.hooksPath .githooks` (done by `pnpm install` in frontend/ and `make dev-up`).
set -uo pipefail

root="$(git rev-parse --show-toplevel)"
zero="0000000000000000000000000000000000000000"

# --- what is being pushed: stdin gives "<local ref> <local sha> <remote ref> <remote sha>" per ref
changed=""
ts_base=""
unknown_base=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue # a branch deletion pushes no code
  if [[ "$remote_sha" != "$zero" ]] && git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    base="$remote_sha"
  else
    base="$(git merge-base "$local_sha" origin/develop 2>/dev/null || true)"
  fi
  if [[ -z "$base" ]]; then
    unknown_base=1 # like CI, a push without a usable base checks both sides
    continue
  fi
  [[ -z "$ts_base" ]] && ts_base="$base"
  changed+="$(git diff --name-only --diff-filter=ACMRD "$base" "$local_sha")"$'\n'
done
changed="$(printf '%s' "$changed" | sed '/^$/d' | sort -u)"

run_backend=0
run_frontend=0
if ((unknown_base)); then
  run_backend=1
  run_frontend=1
fi
grep -q '^backend/' <<<"$changed" && run_backend=1
grep -q '^frontend/' <<<"$changed" && run_frontend=1

if ((run_backend == 0 && run_frontend == 0)); then
  echo "[pre-push] no backend or frontend change in this push: nothing to check"
  exit 0
fi

# --- the checks
check_backend_format() {
  cd "$root/backend" || return 1
  dotnet format backend.slnx --verify-no-changes --no-restore
}

check_backend_architecture() {
  cd "$root/backend" || return 1
  dotnet test tests/Notrelix.Architecture.Tests/Notrelix.Architecture.Tests.csproj --no-restore
}

frontend_ready() {
  [[ -d "$root/frontend/node_modules" ]] || {
    echo "frontend/node_modules is missing, so the frontend checks cannot run."
    return 1
  }
}

check_frontend_prettier() {
  frontend_ready || return 1
  cd "$root/frontend" || return 1
  local files=()
  while IFS= read -r file; do
    [[ -f "$root/$file" ]] && files+=("${file#frontend/}")
  done < <(grep '^frontend/' <<<"$changed")
  ((${#files[@]} == 0)) && return 0
  pnpm exec prettier --check --ignore-unknown "${files[@]}"
}

check_frontend_typecheck() {
  frontend_ready || return 1
  cd "$root/frontend" || return 1
  local base="${ts_base:-origin/develop}"
  pnpm -s turbo run typecheck --continue --filter="...[$base]" --output-logs=errors-only
}

check_frontend_architecture() {
  frontend_ready || return 1
  cd "$root/frontend" || return 1
  pnpm -s check:architecture
}

# --- run them side by side, one log each
logdir="$(mktemp -d)"
trap 'rm -rf "$logdir"' EXIT
names=()
fixes=()
pids=()

launch() {
  local name="$1" fix="$2" fn="$3"
  local n=${#names[@]}
  names+=("$name")
  fixes+=("$fix")
  ("$fn" >"$logdir/$n.log" 2>&1) &
  pids+=($!)
}

echo "[pre-push] checking this push (backend: $run_backend, frontend: $run_frontend)"
if ((run_backend)); then
  launch "backend format (dotnet format, whole solution)" \
    "cd backend && dotnet restore backend.slnx && dotnet format backend.slnx --no-restore   (then commit the changes)" \
    check_backend_format
  launch "backend Architecture tests" \
    "cd backend && dotnet test tests/Notrelix.Architecture.Tests/Notrelix.Architecture.Tests.csproj   (read the failing test, fix the code or the allowlist entry it names)" \
    check_backend_architecture
fi
if ((run_frontend)); then
  launch "frontend prettier (changed files)" \
    "cd frontend && pnpm install --frozen-lockfile && pnpm exec prettier --write --ignore-unknown <the files listed above>   (then commit the changes)" \
    check_frontend_prettier
  launch "frontend typecheck (affected packages)" \
    "cd frontend && pnpm install --frozen-lockfile && pnpm -s turbo run typecheck --continue --filter=\"...[${ts_base:-origin/develop}]\"" \
    check_frontend_typecheck
  launch "frontend check:architecture" \
    "cd frontend && pnpm install --frozen-lockfile && pnpm check:architecture" \
    check_frontend_architecture
fi

failed=0
for i in "${!pids[@]}"; do
  if wait "${pids[$i]}"; then
    echo "[pre-push] ok      ${names[$i]}"
  else
    failed=$((failed + 1))
    echo "[pre-push] FAILED  ${names[$i]}"
    tail -n 40 "$logdir/$i.log" | sed 's/^/             | /'
    echo "             fix: ${fixes[$i]}"
  fi
done

if ((failed > 0)); then
  echo "[pre-push] push blocked: $failed check(s) failed. These are the same checks CI runs first."
  exit 1
fi
echo "[pre-push] all checks passed"
